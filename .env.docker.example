HTTP_ADDRESS=0.0.0.0
PORT=8080

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=booking
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
MAX_ATTEMPTS=30
DELAY=2
