# syntax=docker/dockerfile:1

FROM golang:1.26-alpine AS builder

WORKDIR /src

ARG GOOSE_VERSION=v3.27.1

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 go install github.com/pressly/goose/v3/cmd/goose@${GOOSE_VERSION}

RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/server \
    ./cmd/server

FROM alpine:3.22

RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S app \
    && adduser -S app -G app

WORKDIR /app

COPY --from=builder --chown=app:app /out/server /app/server
COPY --from=builder /go/bin/goose /usr/local/bin/goose
COPY --from=builder --chown=app:app /src/migration /app/migration

USER app

ENV MIGRATION_PATH=/app/migration

EXPOSE 8080

ENTRYPOINT ["sh", "-c", "goose -dir \"$MIGRATION_PATH\" postgres \"host=$POSTGRES_HOST port=$POSTGRES_PORT user=$POSTGRES_USER password=$POSTGRES_PASSWORD dbname=$POSTGRES_DB sslmode=disable\" up && exec /app/server"]
